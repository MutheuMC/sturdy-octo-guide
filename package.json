{
  "name": "pptinit",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"next dev\" \"tsx watch server/index.ts\"",
    "build": "prisma generate && next build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production concurrently -k \"next start\" \"node dist/server/index.js\"",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "prisma migrate deploy",
    "test:integration": "node --env-file=.env tests/integration.mjs",
    "format": "prettier --write app server tests prisma/seed.ts",
    "test:previews": "node --env-file=.env tests/preview-integration.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yauzl": "^3.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^2.10.3",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
