<!-- Place the matching WinSW executable beside this file as pptinit-frontend.exe. -->
<service>
  <id>pptinit-frontend</id>
  <name>pptinit frontend</name>
  <description>Next.js production frontend behind IIS</description>
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <arguments>"C:\pptinit\frontend\node_modules\next\dist\bin\next" start -H 127.0.0.1 -p 3000</arguments>
  <workingdirectory>C:\pptinit\frontend</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec" />
  <stoptimeout>30 sec</stoptimeout>
  <logpath>D:\pptinit-data\logs\frontend</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
