<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 55 MiB request limit: 50 MiB file plus multipart overhead. -->
        <requestLimits maxAllowedContentLength="57671680" />
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="pptinit API" stopProcessing="true">
          <match url="^api/(.*)$" />
          <serverVariables>
            <!-- Add this to IIS URL Rewrite's allowed server variables first. -->
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:4000/api/{R:1}" appendQueryString="true" />
        </rule>
        <rule name="pptinit frontend" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
