# Copy to backend/.env. Replace the example credentials and signing secret.
DATABASE_URL="postgresql://pptinit:CHANGE_ME@127.0.0.1:5432/pptinit"
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
APP_ORIGIN="http://localhost:3000"
PORT=4000
UPLOAD_DIR="./uploads"
# Optional private temporary directory for conversion jobs; defaults to OS temp.
# PREVIEW_TEMP_DIR="/var/lib/pptinit/tmp"

# When deployed behind a trusted local reverse proxy that sets client IP headers:
# TRUST_PROXY="loopback"

# Required in production; install ClamAV and keep its signatures updated.
# CLAMSCAN_PATH="/usr/bin/clamscan"

# Optional in development. Required to enable Word/PowerPoint previews.
# LIBREOFFICE_PATH="/usr/bin/libreoffice"
# Required for production Office previews; use the absolute path in your checkout.
# PREVIEW_SANDBOX_PATH="/absolute/path/to/pptinit/backend/scripts/preview-sandbox.sh"
# Optional read-only runtime mount if LibreOffice is installed outside /usr.
# LIBREOFFICE_RUNTIME_DIR="/opt/libreoffice"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD"
