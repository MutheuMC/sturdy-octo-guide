# Copy this file to .env before running the app.
# Example values only. Never commit your actual .env file.

# PostgreSQL: matches the local database in docker-compose.yml.
DATABASE_URL="postgresql://folio:folio@localhost:5432/folio"

# Required: generate a unique secret with `openssl rand -hex 32`.
# Replace this placeholder; never use it in a deployed app.
JWT_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"

# Exact frontend origin, without a trailing slash. Use your HTTPS URL in production.
APP_ORIGIN="http://localhost:3000"

# Express API port. The Next.js proxy in frontend/next.config.ts expects port 4000.
PORT=4000

# Private upload directory. Use a persistent volume in production.
UPLOAD_DIR="./uploads"

# Used by `npm run db:seed` to create the administrator account.
ADMIN_EMAIL="admin@example.com"
# Set a unique password of at least 8 characters before running the seed.
ADMIN_PASSWORD="replace-with-a-unique-admin-password"

# Optional for local development; required by `npm start` in production.
# Install ClamAV, update its signatures, then set the scanner's absolute path.
# CLAMSCAN_PATH="/usr/bin/clamscan"

# PowerPoint/Word browser previews: absolute path to the LibreOffice executable.
# PDF viewing works without it. Install LibreOffice Impress and Writer on your server.
# LIBREOFFICE_PATH="/usr/bin/libreoffice"
# Required for Office previews in production: the included Linux bubblewrap wrapper.
# Install bubblewrap and enable unprivileged user namespaces on the host.
# Use the absolute path to this file in your checkout.
# PREVIEW_SANDBOX_PATH="/absolute/path/to/pptinit/backend/scripts/preview-sandbox.sh"
# Optional: read-only runtime mount for LibreOffice installed outside /usr.
# LIBREOFFICE_RUNTIME_DIR="/opt/libreoffice"
