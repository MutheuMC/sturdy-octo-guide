# Copy to backend/.env. Use forward slashes for Windows paths.
DATABASE_URL="postgresql://pptinit:CHANGE_ME@127.0.0.1:5432/pptinit"
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
APP_ORIGIN="https://documents.example.com"
PORT=4000
# IIS connects directly to the loopback API and overwrites X-Forwarded-For.
TRUST_PROXY="loopback"
UPLOAD_DIR="D:/pptinit-data/uploads"
PREVIEW_TEMP_DIR="D:/pptinit-data/tmp"
CLAMSCAN_PATH="C:/Program Files/ClamAV/clamscan.exe"
LIBREOFFICE_PATH="C:/Program Files/LibreOffice/program/soffice.com"
# Windows uses the bundled AppContainer launcher automatically.
# Leave PREVIEW_SANDBOX_PATH and LIBREOFFICE_RUNTIME_DIR unset on Windows.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD"
