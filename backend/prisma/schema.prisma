generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role String @default("USER")
  createdAt DateTime @default(now())
  projects Project[]
  sessions Session[]
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  expiresAt DateTime
}
model Project {
  id String @id @default(cuid())
  name String
  ownerId String
  owner User @relation(fields:[ownerId], references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
  documents Document[]
  @@index([ownerId])
}
model Document {
  id String @id @default(cuid())
  name String
  kind String
  url String?
  storageKey String?
  originalName String?
  size Int @default(0)
  previewStatus String @default("NONE")
  previewKey String?
  previewSize Int @default(0)
  previewError String?
  updatedAt DateTime?
  projectId String
  project Project @relation(fields:[projectId], references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
  @@index([projectId])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  resourceId String
  createdAt DateTime @default(now())
}
